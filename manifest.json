{
  "manifest_version": 3,
  "name": "Real Time-Fact Checker",
  "version": "0.1.0",
  "description": "Fact-check claims, articles, and speeches in real time using AI and web search.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://ai.hackclub.com/*",
    "https://search.hackclub.com/*"
  ]
}